# Response headers for every page and file (Cloudflare Workers static assets read this file; Hugo copies it to public/).
# No script, image or connect policy here: the pages load images and live scores from many hosts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
